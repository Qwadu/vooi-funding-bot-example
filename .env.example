# =============================================================================
# vooi-funding-arb-bot — environment configuration
# Copy this to `.env` and fill in the values. Do NOT commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Auth & API
# -----------------------------------------------------------------------------
VOOI_API_BASE_URL=https://perps-api.vooi.io
VOOI_BEARER_TOKEN=                                # required — your VOOI account bearer token

# -----------------------------------------------------------------------------
# Broker / integrator attribution (per-venue, required for every venue you trade)
# Without these, Hyperliquid and Lighter reject your orders.
# Get the values from your VOOI account / broker contact.
# -----------------------------------------------------------------------------
BOT_BROKER_HYPERLIQUID_ID=                        # required if hyperliquid in BOT_TARGET_EXCHANGES — builder address (0x...)
BOT_BROKER_HYPERLIQUID_FEE_BPS=                   # builder fee in bps (e.g. "15")
BOT_BROKER_LIGHTER_ID=                            # required if lighter in BOT_TARGET_EXCHANGES — integrator account index
BOT_BROKER_LIGHTER_FEE_BPS=                       # integrator fee in bps (e.g. "150")
BOT_BROKER_ASTER_ID=                              # required if aster in BOT_TARGET_EXCHANGES — builder address
BOT_BROKER_ASTER_FEE_BPS=                         # builder fee in bps (e.g. "1.5")

BOT_REFUSE_START_WITHOUT_BROKER=true              # fail-fast if a target venue has no broker config

# -----------------------------------------------------------------------------
# Target venues
# -----------------------------------------------------------------------------
BOT_TARGET_EXCHANGES=hyperliquid,lighter          # comma-separated; aster supported but not recommended yet
BOT_INCLUDE_HL_NON_CRYPTO=false                   # true to include Hyperliquid HIP-3 dexes (xyz:, km:) — equities, FX, commodities

# -----------------------------------------------------------------------------
# Position sizing
# -----------------------------------------------------------------------------
BOT_LEG_COLLAT_USD=10                             # margin per leg in USD
BOT_MAX_NOTIONAL_PER_POSITION_USD=100             # cap on (leg_collat × leverage) per arb
BOT_LEVERAGE_TARGET=10
BOT_LEVERAGE_CAP=5                                # hard cap above market maxLeverage
BOT_MAX_MARGIN_PER_EXCHANGE_USD=120               # portfolio cap per venue

# -----------------------------------------------------------------------------
# Opening filters
# Larger MIN_NET_APR → fewer trades, higher per-trade expectancy.
# -----------------------------------------------------------------------------
BOT_MIN_NET_APR=0.70                              # only consider strategies above this APR (decimal: 0.70 = 70%)
BOT_MAX_NET_APR=1.20                              # reject spikes — historically >120% APR collapses fast
BOT_APR_UPPER_CAP=2.0                             # hard ceiling (likely data error)
BOT_MIN_VOLUME_24H_USD=100000                     # min 24h volume on either leg
BOT_PER_LEG_VOLUME_MIN_USD=250000                 # stricter per-leg gate
BOT_APR_RATIO_1H_TO_24H_MAX=5                     # reject 1h spikes vs 24h
BOT_APR_RATIO_24H_TO_7D_MAX=3                     # reject short-window spikes vs week trend
BOT_MAX_ADVERSE_BASIS_BPS=30                      # reject if entry spread is already wide
BOT_ASSET_BLACKLIST=                              # comma-separated; symbols and aliases ("alias:mu")
BOT_ASSET_WHITELIST=                              # comma-separated; empty = no whitelist

# -----------------------------------------------------------------------------
# Slippage
# -----------------------------------------------------------------------------
BOT_MAX_SLIPPAGE_BPS=200                          # per-leg slippage cap on entry

# -----------------------------------------------------------------------------
# Closing criteria
# Soft exits (smart_neg / smart_decl / low_apr) only fire after MIN_HOLD_HOURS.
# Hard exits (hard_stop_loss / max_hold) fire regardless.
# -----------------------------------------------------------------------------
BOT_MAX_HOLD_HOURS=96
BOT_STOP_LOSS_PCT=0.05                            # hard stop: net_usd < -(STOP_LOSS_PCT × collat × 2)
BOT_SAFE_FLOOR_MULT=0.70                          # safe_floor = max(open_apr × MULT, MIN_NET_APR)
BOT_DECLINE_WINDOW=6                              # smart_decl_N: N consecutive declines
BOT_NEGATIVE_WINDOW=3                             # smart_neg_N: N readings below value floor
BOT_SMART_NEG_VALUE_FLOOR=-0.10                   # value floor for smart_neg (-10% APR)
BOT_LOW_APR_THRESHOLD=0.10                        # low_apr_N: N readings below this (10% APR)
BOT_LOW_APR_WINDOW=6
BOT_MIN_HOLD_HOURS=12                             # block soft exits during this initial window
BOT_PAIR_COOLDOWN_AFTER_LOSSES=2                  # after N losses → asset cooldown
BOT_PAIR_COOLDOWN_HOURS=48
BOT_FUNDING_BREAKEVEN_SKIP_SAFE_FLOOR=true        # once funding paid back friction, drop safe_floor gate
BOT_ESTIMATED_FRICTION_BPS=15                     # used in fb_achieved calc
BOT_POST_CLOSE_SETTLE_SEC=20                      # pause after closes before any opens (let venue settle)
BOT_COOLDOWN_FILE=./state-cooldown.json

# -----------------------------------------------------------------------------
# Exchange-side bracket SL/TP (placed at open time)
# -----------------------------------------------------------------------------
BOT_EXCHANGE_SL_ENABLED=true
BOT_EXCHANGE_SL_BUFFER_PCT=0.05                   # SL = liq + (entry-liq) × buffer (close to liquidation but not at)

# -----------------------------------------------------------------------------
# LIMIT-then-MARKET entry mode
# Bot tries an ALO post-only limit on the cheaper leg first, then market for the other.
# -----------------------------------------------------------------------------
BOT_LIMIT_ALO_ENABLED=true
BOT_LIMIT_ALO_OFFSET_BPS=5                        # post limit this many bps away from mid
BOT_LIMIT_ALO_TIMEOUT_SEC=600                     # cancel and fall back to market if unfilled
BOT_LIMIT_ALO_DRIFT_BPS=50                        # cancel earlier if mid drifts this much
BOT_LIMIT_ALO_POLL_SEC=5
BOT_LIMIT_ALO_LEG_SIDE=auto

# -----------------------------------------------------------------------------
# Close-side ALO (opt-in: try post-only limit close before market fallback)
# Skipped automatically on urgent exits (hard_stop_loss / max_hold).
# -----------------------------------------------------------------------------
BOT_LIMIT_ALO_CLOSE_ENABLED=false                 # opt-in; market-only behaviour by default
BOT_LIMIT_ALO_CLOSE_TIMEOUT_SEC=60                # cancel ALO close and fall back to market after this
BOT_LIMIT_ALO_CLOSE_OFFSET_BPS=5                  # post limit this many bps passive-side from mid

# -----------------------------------------------------------------------------
# Margin headroom
# -----------------------------------------------------------------------------
BOT_MARGIN_HEADROOM_PCT=0.005                     # shave order size by 0.5% to avoid "insufficient margin"

# -----------------------------------------------------------------------------
# Timing
# -----------------------------------------------------------------------------
BOT_LOOP_INTERVAL_SEC=300                         # monitor cycle — every 5 min
BOT_TRADING_CYCLE_SEC=3600                        # trading cycle — every hour

# -----------------------------------------------------------------------------
# Run mode
# -----------------------------------------------------------------------------
BOT_DRY_RUN=true                                  # SAFE DEFAULT. Set false only when you trust your config.
BOT_STATE_FILE=./state.ndjson                     # event log NDJSON
BOT_SNAPSHOT_FILE=./state-snapshot.json           # restartable snapshot
BOT_PID_FILE=/tmp/vooi-funding-arb-bot.pid        # single-instance lock

# =============================================================================
# Probe script (optional Phase 0 API validation; see probe/README.md)
# =============================================================================
PROBE_MAX_NOTIONAL_USD=20
PROBE_ASSET_PRIMARY=BTC
PROBE_ASSET_SECONDARY=ETH
PROBE_RUNS_DIR=./probe/runs
